{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.cn/novel-adaptation/ai/story-knowledge.schema.json",
  "title": "Story knowledge AI stage response",
  "type": "object", "additionalProperties": false,
  "required": ["contractVersion", "jobId", "stage", "projectId", "chapterId", "sourceVersionId", "status", "items"],
  "properties": {
    "contractVersion": { "const": "0.1.0" }, "jobId": { "type": "string" }, "stage": { "const": "storyKnowledge" },
    "projectId": { "type": "string" }, "chapterId": { "type": "string" }, "sourceVersionId": { "type": "string" },
    "status": { "enum": ["succeeded", "partially_succeeded", "failed"] },
    "items": { "type": "array", "items": { "$ref": "#/$defs/itemResult" } }
  },
  "$defs": {
    "sourceRef": { "type": "object", "additionalProperties": false, "required": ["sourceVersionId", "fragmentId"], "properties": { "sourceVersionId": { "type": "string" }, "fragmentId": { "type": "string" } } },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "factType", "statement", "assertionKind", "resolutionStatus", "evidence"],
      "properties": {
        "id": { "type": "string" }, "factType": { "enum": ["character", "relationship", "event", "location", "prop", "worldRule"] },
        "statement": { "type": "string", "minLength": 1 }, "assertionKind": { "enum": ["explicit", "inferred", "user_confirmed"] },
        "resolutionStatus": { "enum": ["resolved", "pending_identity", "conflicting"] }, "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "failure": { "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "retryable": { "type": "boolean" } } },
    "itemResult": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["scopeKey", "status", "value"], "properties": { "scopeKey": { "type": "string" }, "status": { "const": "succeeded" }, "value": { "$ref": "#/$defs/fact" } } },
        { "type": "object", "additionalProperties": false, "required": ["scopeKey", "status", "error"], "properties": { "scopeKey": { "type": "string" }, "status": { "const": "failed" }, "error": { "$ref": "#/$defs/failure" } } }
      ]
    }
  }
}
