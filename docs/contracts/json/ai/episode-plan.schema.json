{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.cn/novel-adaptation/ai/episode-plan.schema.json",
  "title": "Episode plan AI recommendation response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion", "jobId", "stage", "resultType", "projectId", "chapterId", "sourceVersionId",
    "upstreamConfirmedVersionIds", "status", "recommendationRationale", "episodes", "majorAdaptationProposals"
  ],
  "properties": {
    "contractVersion": { "const": "0.1.0" },
    "jobId": { "type": "string", "minLength": 1 },
    "stage": { "const": "script" },
    "resultType": { "const": "episodePlan" },
    "projectId": { "type": "string", "minLength": 1 },
    "chapterId": { "type": "string", "minLength": 1 },
    "sourceVersionId": { "type": "string", "minLength": 1 },
    "upstreamConfirmedVersionIds": {
      "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": { "const": "succeeded" },
    "recommendationRationale": { "type": "string", "minLength": 1 },
    "episodes": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/episode" }
    },
    "majorAdaptationProposals": {
      "type": "array",
      "items": { "$ref": "#/$defs/majorAdaptationProposal" }
    }
  },
  "$defs": {
    "nonEmptyUniqueIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "episode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "ordinal", "title", "sourceFragmentIds", "coreEventFactIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "sourceFragmentIds": { "$ref": "#/$defs/nonEmptyUniqueIds" },
        "coreEventFactIds": { "$ref": "#/$defs/nonEmptyUniqueIds" }
      }
    },
    "majorAdaptationProposal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "summary", "rationale", "affectedFactIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["merge_characters", "delete_core_event", "reorder_events"] },
        "summary": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "affectedFactIds": { "$ref": "#/$defs/nonEmptyUniqueIds" }
      }
    }
  }
}
