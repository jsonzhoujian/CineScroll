{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.cn/novel-adaptation/project.schema.json",
  "title": "Canonical novel adaptation project",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "project", "source", "adaptationPlan", "stageResults", "adaptationAdditions", "impactLinks", "suggestions", "aiJobs", "exportMetadata"],
  "properties": {
    "contractVersion": { "const": "0.1.0" },
    "project": { "$ref": "#/$defs/project" },
    "source": { "$ref": "#/$defs/source" },
    "adaptationPlan": { "$ref": "#/$defs/adaptationPlan" },
    "stageResults": {
      "type": "array",
      "items": { "$ref": "#/$defs/stageResult" },
      "minItems": 4,
      "maxItems": 4
    },
    "adaptationAdditions": { "type": "array", "items": { "$ref": "#/$defs/adaptationAddition" } },
    "impactLinks": { "type": "array", "items": { "$ref": "#/$defs/impactLink" } },
    "suggestions": { "type": "array", "items": { "$ref": "#/$defs/suggestion" } },
    "aiJobs": { "type": "array", "items": { "$ref": "#/$defs/aiJob" } },
    "exportMetadata": { "$ref": "#/$defs/exportMetadata" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*_[A-Za-z0-9-]{2,}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "workspaceId", "title", "ownerUserId", "aspectRatio", "narrativeMode", "dataRegion", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "workspaceId": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 },
        "ownerUserId": { "$ref": "#/$defs/id" }, "aspectRatio": { "enum": ["9:16", "16:9"] },
        "narrativeMode": { "enum": ["narration", "dialogue"] }, "dataRegion": { "const": "CN" }, "createdAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["chapterId", "title", "activeSourceVersionId", "versions"],
      "properties": {
        "chapterId": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "activeSourceVersionId": { "$ref": "#/$defs/id" },
        "versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceVersion" } }
      }
    },
    "sourceVersion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "ordinal", "createdAt", "createdBy", "characterCount", "fragments"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "ordinal": { "type": "integer", "minimum": 1 }, "createdAt": { "$ref": "#/$defs/timestamp" }, "createdBy": { "$ref": "#/$defs/id" },
        "characterCount": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "fragments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceFragment" } }
      }
    },
    "sourceFragment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "ordinal", "startOffset", "endOffset", "text", "contentHash"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "ordinal": { "type": "integer", "minimum": 1 }, "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 1 }, "text": { "type": "string", "minLength": 1 }, "contentHash": { "type": "string", "minLength": 8 }
      }
    },
    "adaptationPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "targetDurationSeconds", "status", "episodes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "targetDurationSeconds": { "enum": [60, 180, 300] }, "status": { "enum": ["candidate", "confirmed"] },
        "episodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/episode" } }
      }
    },
    "episode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "ordinal", "title", "sourceFragmentIds", "coreEventFactIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "ordinal": { "type": "integer", "minimum": 1 }, "title": { "type": "string", "minLength": 1 },
        "sourceFragmentIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "coreEventFactIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "stageResult": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "activeVersionId", "confirmedVersionId", "versions"],
      "properties": {
        "stage": { "enum": ["storyKnowledge", "script", "settings", "storyboard"] }, "activeVersionId": { "$ref": "#/$defs/id" },
        "confirmedVersionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contentVersion" } }
      }
    },
    "contentVersion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "ordinal", "status", "parentVersionId", "createdAt", "createdBy", "creationMethod", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "ordinal": { "type": "integer", "minimum": 1 }, "status": { "enum": ["candidate", "needs_resolution", "confirmed", "superseded", "restricted"] },
        "parentVersionId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "createdAt": { "$ref": "#/$defs/timestamp" }, "createdBy": { "$ref": "#/$defs/id" },
        "creationMethod": { "enum": ["ai", "manual", "suggestion", "regeneration"] }, "confirmedBy": { "$ref": "#/$defs/id" }, "confirmedAt": { "$ref": "#/$defs/timestamp" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/contentItem" } }
      },
      "allOf": [{ "if": { "properties": { "status": { "const": "confirmed" } } }, "then": { "required": ["confirmedBy", "confirmedAt"] } }]
    },
    "contentItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "ordinal", "label", "content", "provenance", "locked"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["storyFact", "scene", "scriptElement", "settingAsset", "storyboard", "shot"] },
        "ordinal": { "type": "integer", "minimum": 1 }, "label": { "type": "string", "minLength": 1 }, "content": { "type": "object" },
        "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provenance" } }, "locked": { "type": "boolean" },
        "lockedBy": { "$ref": "#/$defs/id" }, "lockedAt": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [{ "if": { "properties": { "locked": { "const": true } } }, "then": { "required": ["lockedBy", "lockedAt"] } }]
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "sourceVersionId", "fragmentId", "transformation"],
          "properties": { "type": { "const": "source_fragment" }, "sourceVersionId": { "$ref": "#/$defs/id" }, "fragmentId": { "$ref": "#/$defs/id" }, "transformation": { "enum": ["retained", "compressed", "merged", "visualized", "actionized", "narrated", "sonified"] } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "additionId"],
          "properties": { "type": { "const": "approved_addition" }, "additionId": { "$ref": "#/$defs/id" } }
        }
      ]
    },
    "adaptationAddition": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "reason", "status", "proposedBy", "proposedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "description": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "approved", "rejected"] }, "proposedBy": { "$ref": "#/$defs/id" }, "proposedAt": { "$ref": "#/$defs/timestamp" },
        "decidedBy": { "$ref": "#/$defs/id" }, "decidedAt": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [{ "if": { "properties": { "status": { "enum": ["approved", "rejected"] } } }, "then": { "required": ["decidedBy", "decidedAt"] } }]
    },
    "impactLink": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "upstreamVersionId", "upstreamItemId", "downstreamVersionId", "downstreamItemId", "status", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "upstreamVersionId": { "$ref": "#/$defs/id" }, "upstreamItemId": { "$ref": "#/$defs/id" },
        "downstreamVersionId": { "$ref": "#/$defs/id" }, "downstreamItemId": { "$ref": "#/$defs/id" }, "status": { "enum": ["unreviewed", "keep", "revise", "regenerate", "resolved"] },
        "createdAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "suggestion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "targetVersionId", "targetItemId", "replacement", "reason", "status", "createdBy", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "targetVersionId": { "$ref": "#/$defs/id" }, "targetItemId": { "$ref": "#/$defs/id" },
        "replacement": {}, "reason": { "type": "string", "minLength": 1 }, "status": { "enum": ["open", "accepted", "rejected", "withdrawn"] },
        "createdBy": { "$ref": "#/$defs/id" }, "createdAt": { "$ref": "#/$defs/timestamp" }, "decidedBy": { "$ref": "#/$defs/id" }, "decidedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "aiJob": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "stage", "status", "scopeKeys", "estimatedCredits", "settledCredits"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "stage": { "enum": ["storyKnowledge", "script", "settings", "storyboard"] },
        "status": { "enum": ["queued", "running", "succeeded", "partially_succeeded", "failed", "cancelled"] },
        "scopeKeys": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "retryOfJobId": { "$ref": "#/$defs/id" }, "estimatedCredits": { "type": "number", "minimum": 0 }, "settledCredits": { "type": "number", "minimum": 0 }
      }
    },
    "exportMetadata": {
      "type": "object", "additionalProperties": false,
      "required": ["generatedAt", "confirmationScope", "formats"],
      "properties": {
        "generatedAt": { "$ref": "#/$defs/timestamp" }, "confirmationScope": { "enum": ["confirmed_only", "includes_candidates"] },
        "formats": { "type": "array", "minItems": 1, "items": { "enum": ["json", "docx", "xlsx"] }, "uniqueItems": true }
      }
    }
  }
}
